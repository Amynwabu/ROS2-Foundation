{
  "name": "ROS2 Humble (Codespaces / Dev Container)",
  "image": "osrf/ros:humble-desktop-full",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "upgradePackages": false,
      "username": "vscode",
      "userUid": "automatic",
      "userGid": "automatic"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "ros2",
      "webPort": "6080"
    }
  },

  "remoteUser": "vscode",

  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop (rqt_graph, rviz2) - password: ros2",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cmake-tools",
        "ms-iot.vscode-ros"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "files.associations": {
          "*.repos": "yaml",
          "*.world": "xml",
          "*.xacro": "xml"
        }
      }
    }
  },

  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined"
  ],

  "containerEnv": {
    "ROS_DOMAIN_ID": "42"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
